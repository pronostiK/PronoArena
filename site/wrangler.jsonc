{
  // Site Duel Prono (nom interne inchangé : prono-arena ; pages statiques), publié automatiquement à chaque mise à jour du dossier site/
  "name": "prono-arena",
  "compatibility_date": "2026-11-06",
  // Adresse publique du site. L'ancienne adresse en workers.dev reste active.
  "routes": [
    { "pattern": "duelprono.com", "custom_domain": true },
    { "pattern": "www.duelprono.com", "custom_domain": true },
    // duelprono.fr affiche le même site, qui renvoie aussitôt vers duelprono.com (début de app.js)
    { "pattern": "duelprono.fr", "custom_domain": true },
    { "pattern": "www.duelprono.fr", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": { "directory": "./public" }
}
