{
  // Configuration du moteur Duel Prono (nom interne inchangé : prono-arena-worker) (publié automatiquement par Cloudflare à chaque mise à jour du dépôt)
  "name": "prono-arena-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  // Conserve les variables déjà réglées dans Cloudflare (dont FOOTBALL_DATA_KEY) : la clé n'est jamais dans le code
  "keep_vars": true,
  // Adresse publique du moteur. L'ancienne adresse en workers.dev reste active (anciennes versions du site en mémoire).
  "routes": [{ "pattern": "api.duelprono.com", "custom_domain": true }],
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "PRONO_CACHE", "id": "3aa538a17aa74a9190372cfe9799fa84" }
  ],
  // Base de l'Arène (comptes joueurs, pronostics, classement) : tables décrites dans schema.sql
  "d1_databases": [
    { "binding": "DB", "database_name": "prono-arena", "database_id": "44108fa4-5b70-4731-a0e4-33605e47a1dc" }
  ],
  // Robot : passage toutes les 10 minutes (mise à jour des données et des pronostics)
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true, "logs": { "invocation_logs": true } }
}
