{
  // Configuration du moteur Prono Arena (publié automatiquement par Cloudflare à chaque mise à jour du dépôt)
  "name": "prono-arena-worker",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  // Conserve les variables déjà réglées dans Cloudflare (dont FOOTBALL_DATA_KEY) : la clé n'est jamais dans le code
  "keep_vars": true,
  "kv_namespaces": [
    { "binding": "PRONO_CACHE", "id": "3aa538a17aa74a9190372cfe9799fa84" }
  ],
  "observability": { "enabled": true }
}
